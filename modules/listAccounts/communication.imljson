{
    "url": "/accounts",
    "method": "GET",
    "qs": {
        "limit": 100,
        "status": "{{parameters.status}}",
        "provider": "{{parameters.provider}}"
    },
    "response": {
        "iterate": "{{body.items}}",
        "output": "{{item}}",
        "limit": "{{parameters.limit}}"
    },
    "pagination": {
        "qs": {
            "cursor": "{{body.next_cursor}}"
        },
        "condition": "{{body.next_cursor}}"
    }
}
