{
    "url": "/accounts",
    "method": "GET",
    "qs": {
        "limit": 100
    },
    "response": {
        "limit": 500,
        // Only messaging accounts can send; AI and productivity accounts stay out of the list.
        "iterate": {
            "container": "{{body.items}}",
            "condition": "{{item.type = 'messaging'}}"
        },
        "output": {
            "label": "{{ifempty(item.display_name, item.id) + ' (' + item.provider + ', ' + item.status + ')'}}",
            "value": "{{item.id}}"
        }
    },
    "pagination": {
        "qs": {
            "cursor": "{{body.next_cursor}}"
        },
        "condition": "{{body.next_cursor}}"
    }
}
