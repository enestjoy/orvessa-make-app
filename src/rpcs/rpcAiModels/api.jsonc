{
    // The models the workspace's connected providers offer, as "provider/model".
    "url": "/ai/models",
    "method": "GET",
    "response": {
        "limit": 500,
        "iterate": "{{body.data}}",
        "output": {
            "label": "{{item.id}}",
            "value": "{{item.id}}"
        }
    }
}
