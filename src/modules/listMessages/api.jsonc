{
    "url": "/conversations/{{encodeURL(parameters.conversation_id)}}/messages",
    "method": "GET",
    "qs": {
        "limit": 100
    },
    "response": {
        "iterate": "{{body.items}}",
        "output": "{{item}}",
        "limit": "{{parameters.limit}}"
    },
    "pagination": {
        "qs": {
            "cursor": "{{body.next_cursor}}"
        },
        "condition": "{{body.next_cursor}}"
    }
}
